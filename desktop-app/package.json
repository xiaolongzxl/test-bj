{
  "name": "desktop-app",
  "version": "1.0.1",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cross-env NODE_ENV=development electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build-h5": "cd .. && npm run nbuild:prod",
    "publish": "cross-env GITHUB_TOKEN=%GITHUB_TOKEN% electron-builder --win --publish always"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "latest",
    "electron-builder": "latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "build": {
    "appId": "com.wandadianli.myapp",
    "productName": "万达电力",
    "asar": false,
    "publish": {
      "provider": "generic",
      "url": "https://wddlsz.oss-cn-hangzhou.aliyuncs.com/electron/"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "utils/**/*",
      "assets/**/*",
      "dist/**/*"
    ],
    "extraResources": [],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/logo.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "nsis": {
      "language": "2052",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2"
  }
}
